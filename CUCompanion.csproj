<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>CUCompanion</AssemblyName>
    <RootNamespace>CUCompanion</RootNamespace>
    <Version>2.2.0</Version>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>CS0169;CS0414;CS0649;CS8632</NoWarn>

    <GameDir>D:\STEAM\steamapps\common\Casualties Unknown</GameDir>
    <ManagedDir>$(GameDir)\CasualtiesUnknown_Data\Managed</ManagedDir>
    <BepCoreDir>$(GameDir)\BepInEx\core</BepCoreDir>
    <DeployDir>$(GameDir)\BepInEx\plugins\CUCompanion</DeployDir>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="src\**\*.cs" />
    <EmbeddedResource Include="assets\about_artwork1.png" />
    <EmbeddedResource Include="assets\about_artwork2.png" />
    <EmbeddedResource Include="assets\about_artwork.png" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Net.Http" />
    <Reference Include="BepInEx">
      <HintPath>$(BepCoreDir)\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
